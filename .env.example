# ── Cloud LLM keys (Phase 1 MVP runs on cloud APIs) ──────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── Control Plane: Host Launcher micro-API (ADR-07) ──────────────
LAUNCHER_HOST=127.0.0.1
LAUNCHER_PORT=9000
LAUNCHER_SECRET=            # REQUIRED if LAUNCHER_HOST != 127.0.0.1 (X-Launcher-Secret header)

# ── Control Plane: Paperclip (Phase 3) ───────────────────────────
BETTER_AUTH_SECRET=         # REQUIRED by Paperclip (session signing; openssl rand -hex 32)
PAPERCLIP_PUBLIC_URL=http://localhost:3000
# Docker Compose maps host :3000 -> Paperclip container :3100.

# ── Control Plane: PostgreSQL (Paperclip persistence, Phase 3) ──
POSTGRES_PASSWORD=          # docker-compose.yml requires this to be set

# ── Daemon auth (Hermes serve + Goose serve) — MUST be distinct ──
API_SERVER_KEY=            # Hermes credential name (see spec §2.3: non-loopback
                           # binds require Hermes's own auth provider)
GOOSE_SERVER__SECRET_KEY=  # goose serve auth (HTTP/WS ACP /acp)

# ── Ports for locally-running daemons (see execution-plane/scripts/ports.env) ─
HERMES_PORT_CEo=8642
GOOSE_PORT_DEV=3284
