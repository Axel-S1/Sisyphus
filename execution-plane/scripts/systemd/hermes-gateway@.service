# hermes-gateway@.service — Hermes gateway (resident HTTP API), one instance
# per profile. Installed to /etc/systemd/system/ by install-systemd.sh
# (substitutes @@REPO@@ / @@USER@@). Instance name (%i) is the profile; the
# ADR-06 registry (execution-plane/scripts/ports.env) maps profile → port and
# run.sh resolves it (e.g. ceo → HERMES_PORT_CEo=8642).
#
# ⚠ Delegates to run.sh for symmetric HERMES_HOME/GOOSE_PATH_ROOT injection
# (ADR-03) and hard-fail checks. Auth secret (API_SERVER_KEY) comes from the
# repo .env — protected file, never inlined in unit files (R8).
[Unit]
Description=Hermes gateway HTTP API (profile %i)
After=network.target

[Service]
Type=simple
User=@@USER@@
Group=@@USER@@
WorkingDirectory=@@REPO@@
ExecStart=@@REPO@@/execution-plane/scripts/run.sh %i hermes
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
