# ── Secrets & local env (R8: never commit) ─────────────────────────
.env
ports.env

# ── Spec-mandated ignores ──────────────────────────────────────────
# R8: agent state under storage/ is NEVER committed. Hermes runtime data
# (state.db, auth.lock, channel_directory.json, memories/, locks, ...) is
# ignored wholesale — not just sessions/logs — so `git add -A` cannot leak it.
storage/hermes_data/**
!storage/hermes_data/**/
!storage/hermes_data/**/.gitkeep
storage/goose_data/**
!storage/goose_data/**/
!storage/goose_data/**/.gitkeep
storage/paperclip_data/*
!storage/paperclip_data/.gitkeep
storage/paperclip_pgdata/
storage/launcher*.log
execution-plane/workspace/*
!execution-plane/workspace/.gitkeep

# ── General hygiene ────────────────────────────────────────────────
node_modules/
__pycache__/
.pytest_cache/
*.pyc
.DS_Store
